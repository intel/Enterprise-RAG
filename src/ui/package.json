{
  "name": "intel-enterprise-rag-ui-workspace",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm -r build && pnpm audit",
    "validate:fix": "pnpm run lint:fix && pnpm run format && pnpm audit --fix",
    "clean": "pnpm -r exec -- rm -rf dist node_modules && rm -rf node_modules",
    "rebuild": "pnpm run clean && pnpm install && pnpm -r build",
    "dev:chatqna": "pnpm --filter @intel-enterprise-rag-ui/chatqna run dev",
    "dev:audioqna": "pnpm --filter @intel-enterprise-rag-ui/audioqna run dev",
    "dev:docsum": "pnpm --filter @intel-enterprise-rag-ui/docsum run dev",
    "a11y:axe": "axe --dir ./a11y-reports --save axe-report.json --exit",
    "a11y:lighthouse": "lighthouse --output=html --output-path=./a11y-reports/lighthouse.html --only-categories=accessibility --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.12",
    "@xyflow/react": "^12.3.1",
    "classnames": "^2.5.1",
    "dompurify": "^3.4.16",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@eslint/js": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.5.2",
    "@types/punycode": "^2.1.4",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.8.0",
    "lighthouse": "^13.5.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10",
    "pnpm": ">=9"
  }
}
