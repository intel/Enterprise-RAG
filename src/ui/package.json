{
  "name": "intel-enterprise-rag-ui-workspace",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm -r build && pnpm audit",
    "validate:fix": "pnpm run lint:fix && pnpm run format && pnpm audit --fix"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.12",
    "@xyflow/react": "^12.3.1",
    "classnames": "^2.5.1",
    "dompurify": "^3.3.2",
    "lodash.debounce": "^4.0.8",
    "luxon": "^3.6.1",
    "react": "^18.3.1",
    "react-aria-components": "^1.7.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.0",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.5.2",
    "@types/punycode": "^2.1.4",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.8.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.13",
    "tailwindcss-react-aria-components": "^1.1.6",
    "typescript": "^5.5.4",
