## Retriever Microservice Settings
VECTOR_STORE='redis'

## Vector Store Access Restriction
EDP_BACKEND_ENDPOINT="http://edp-backend.edp.svc:5000"
VECTOR_DB_RBAC="false" # if anything other than "false" is set, the vector store queries will be filtered by RBAC

## Vector Store Settings
REDIS_URL='redis://localhost:6379/0'
VECTOR_ALGORITHM="FLAT" # "FLAT", "HNSW"
VECTOR_DIMS="768" # Depends on model used in embedding. For example bge-large-en-v1.5=768, bge-large-en-v1.5=1024
VECTOR_DATATYPE="FLOAT32" # FLOAT16, FLOAT32, FLOAT64
VECTOR_DISTANCE_METRIC="COSINE" # L2, IP, COSINE
### For HNSW Algorithm additional settings are available
VECTOR_HNSW_M="32"
VECTOR_HNSW_EF_CONSTRUCTION="32"
VECTOR_HNSW_EF_RUNTIME="32"
VECTOR_HNSW_EPSILON="0.01"

## Hybrid Search Settings (contextual BM25 + contextual embeddings fused with RRF)
## Enabled automatically by the deployment when edp_contextual_rag_enabled is true.
## When True, requests asking for search_type "similarity" are served as "hybrid".
## Use search_type "vector" to force dense-only retrieval, "hybrid" to force hybrid
## retrieval even when this flag is False. Redis vector store only.
HYBRID_SEARCH_ENABLED="False" # True or False
HYBRID_SEARCH_CANDIDATE_K="100" # candidates fetched from EACH leg before fusion
HYBRID_SEARCH_RESULT_K="20"     # depth of the fused list handed to the reranker (>= k)
HYBRID_SEARCH_RRF_K="0"         # rank-smoothing constant; 0 = Anthropic's weight/rank
HYBRID_SEARCH_SEMANTIC_WEIGHT="0.8"
HYBRID_SEARCH_BM25_WEIGHT="0.2"

## Metadata Filtering Settings
## Controls how metadata is extracted from queries for filtering.
## Options: off (default, disabled), regex_only, hybrid (regex+NER), ner_only
METADATA_EXTRACTION_MODE=off
## Language for regex patterns and name lemmatization ('en' or 'pl')
METADATA_LANGUAGE=en

## NER Model Server Settings (used when METADATA_EXTRACTION_MODE=hybrid or ner_only)
## NER_ENDPOINT - URL of the NER OVMS Gateway; required for hybrid/ner_only modes
# NER_ENDPOINT=http://localhost:9001

## Uncomment to change the microservice port
#RETRIEVER_USVC_PORT=6620

## Uncomment to change the microservice log level
# ERAG_LOGGER_LEVEL=INFO
