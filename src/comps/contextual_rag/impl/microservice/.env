## Contextual RAG Microservice Settings
# LLM that writes the per-chunk context blurb. In a deployment this is a dedicated blurb
# model, qwen3-4b-w8a8-blurb (RedHatAI/Qwen3-4B-Instruct-2507-quantized.w8a8), sized like
# the answer LLM and deployed next to it so ingestion never competes with query serving.
# There is NO default: the model is deployed separately (model-manager / KServe -- see
# deployment/models.yaml), so both values below are mandatory and the service refuses to
# start without them. Nothing is filled in by hand in a deployment though -- the Helm
# chart fills them from contextualRag.config.vllm_endpoint / .context_model_name, which
# the deployment propagates from the inference_models entry with role: contextual_rag (its
# own KServe Service, not the AI gateway, which serves neither /tokenize nor max_model_len).
# Any OpenAI-compatible /v1/chat/completions endpoint works, e.g.
#   http://qwen3-4b-w8a8-blurb-kserve-workload-svc.llm-inference.svc:8000
VLLM_SERVER_ENDPOINT=""
CONTEXT_MODEL_NAME=""
# Blurbs are 50-100 tokens in the Anthropic reference implementation.
MAX_NEW_TOKENS=100
# Chunks of a document kept in flight at once. vLLM batches whatever is in flight,
# so this is the effective batch size for a document.
CONTEXT_MAX_CONCURRENCY=32
# Token budget for one blurb request: the WHOLE source document + the WHOLE chunk + the
# chat template + MAX_NEW_TOKENS. A document is contextualised only if the request for
# every one of its chunks fits; otherwise it is skipped and its chunks are indexed
# unchanged. Documents are never truncated. Prompt length is measured exactly with the
# server's /tokenize endpoint. 16384 is the window qwen3-4b-w8a8-blurb is served with and
# contextualises 606 of the 607 MultiHop-RAG corpus documents whole (98.9% of their
# chunks). The budget is capped at the window the server reports in /v1/models; 0 = use
# that whole served window.
CONTEXT_MAX_PROMPT_TOKENS=16384
# Only used if /tokenize is unreachable (it is a vLLM extension, not part of the OpenAI
# API): chars-per-token estimate of the prompt length. Below the ~4.0 English average so
# the estimate errs towards over-counting, i.e. towards skipping rather than overflowing.
CONTEXT_CHARS_PER_TOKEN=3.5
CONTEXT_REQUEST_TIMEOUT=300
CONTEXT_MAX_RETRIES=2
# Pin all chunks of a document to one model server replica so its cached document prefix
# is reused. Needs pod-level addresses, i.e. a headless Service (default
# "<hostname>-headless"); behind a ClusterIP Service or a gateway this degrades to the
# single configured URL and the server side decides placement.
CONTEXT_STICKY_ROUTING=true
#CONTEXT_VLLM_REPLICA_HOST=""
CONTEXT_VLLM_REPLICA_TTL=60
# The LLM is in-cluster, and sticky routing dials pod IPs that no_proxy does not
# cover, so env proxies are ignored. Set true only for an external endpoint.
CONTEXT_TRUST_ENV_PROXY=false

## Uncomment to change the microservice port
#CONTEXTUAL_RAG_USVC_PORT=8004

## Uncomment to change the microservice log level
# ERAG_LOGGER_LEVEL=INFO
