cluster:
  enabled: {{ nats_cluster_enabled | bool | string | lower }}
  replicas: {{ nats_replicas }}

auth:
  existingSecret: "{{ nats_auth_secret_name }}"

kv:
  bucket: "{{ nats_kv_bucket }}"

{% if nats_additional_values is defined and nats_additional_values %}
{{ nats_additional_values | to_nice_yaml }}
{% endif %}

monitoring:
  enabled: {{ observability_enabled | default(true) | bool | string | lower }}
{% if cluster_distribution | default('kubernetes') == 'openshift' %}

# OpenShift assigns the UID and fsGroup (restricted-v2). The Helm post-renderer
# does not see hooks (the kv-init Job), so unset them here too.
securityContext:
  runAsUser: null
  runAsGroup: null
  fsGroup: null
{% endif %}
